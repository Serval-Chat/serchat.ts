{
  "name": "serchat.ts",
  "version": "0.1.0",
  "description": "TypeScript SDK for Serchat",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && npm run build:js && npm run build:types",
    "build:js": "esbuild src/index.ts --bundle --minify --platform=node --format=esm --outfile=dist/index.js --external:ws --tree-shaking=true",
    "build:types": "dts-bundle-generator -o dist/index.d.ts src/index.ts --no-check",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "prepare": "husky install",
    "type-check": "tsc --noEmit",
    "docs": "typedoc"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "knip": "^6.4.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.2.0",
    "vitest": "^4.1.4"
  }
}
